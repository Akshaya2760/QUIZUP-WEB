# MongoDB Atlas Connection String (Targeting QUIZUP database)
# Example: mongodb+srv://<user>:<password>@cluster0.abcde.mongodb.net/QUIZUP?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/QUIZUP?retryWrites=true&w=majority"

# Secret key for Express session cookies
SESSION_SECRET="quizup-secret-session-key-change-in-production-2026"

# Secret required to bootstrap the first administrator
ADMIN_SETUP_SECRET="admin-setup-secret-2026"

# Secure cookie flag (true in HTTPS production, false in local dev)
COOKIE_SECURE="false"

# Google Gemini API Key for AI Study Assistant
GEMINI_API_KEY=""

# Deployment URL
APP_URL="http://localhost:3000"
